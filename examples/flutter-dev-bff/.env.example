# Flutter Dev BFF 配置文件模板
# 复制为 .env（已被 gitignore）并填写真实值

# 32 字节 base64url 主密钥（openssl rand -base64 32 | tr +/ -_ | tr -d =）
AGENT_KIT_MASTER_KEY=

# Web UI 和 API 访问令牌
BFF_API_TOKEN=dev-token

# Flutter 项目路径（含 pubspec.yaml 的目录）
FLUTTER_PROJECT_PATH=/path/to/your/flutter/app

# 主 LLM 配置（纯文本推理模型）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# 视觉模型配置（可选，用于 mobile_screen_analyze）
# VISION_API_KEY=
# VISION_MODEL=
# VISION_BASE_URL=http://localhost:11434/v1

# 日志级别：info 或 verbose
# LOG_LEVEL=verbose
# LLM_MAX_RETRIES=3
# PORT=8788

# 启用 Android Companion App（替代 uiautomator dump）
# COMPANION_ENABLED=1