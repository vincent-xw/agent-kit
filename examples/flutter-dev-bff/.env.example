# Flutter Dev BFF 配置文件模板
# 复制为 .env（已被 gitignore）并填写真实值

# 32 字节 base64url 主密钥（openssl rand -base64 32 | tr +/ -_ | tr -d =）
AGENT_KIT_MASTER_KEY=

# Web UI 和 API 访问令牌
BFF_API_TOKEN=dev-token

# Flutter 项目路径（含 pubspec.yaml 的目录）
FLUTTER_PROJECT_PATH=/path/to/your/flutter/app

# 主 LLM 配置（纯文本推理模型）
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com

# 视觉模型配置（可选，用于 mobile_screen_analyze）
# VISION_API_KEY=
# VISION_MODEL=
# VISION_BASE_URL=http://localhost:11434/v1

# 日志级别：info 或 verbose
# LOG_LEVEL=verbose
# LLM_MAX_RETRIES=3
# PORT=8788

# ── 文件日志（按日轮转，默认开启）──
# 总开关：1=开启写日志文件；0=关闭
# LOG_TO_FILE=1
# 日志目录（默认 BFF 数据目录/log；相对路径以数据目录为基准，如 log → <数据目录>/log）
# LOG_DIR=log
# LOG_FORMAT 支持的 3 种：
#   verbose —— 多行人类可读，含完整 LLM 输入输出（Prompt、会话历史、工具调用、模型原文），体量最大、不含 API Key
#   json    —— 每条事件一行 JSON，便于脚本/工具解析
#   audit   —— 仅非敏感摘要（requestId、模型、工具、耗时、HTTP 状态、错误码），不含 Prompt/业务内容
# LOG_FORMAT=verbose
# 保留文件天数，0=永久保留；仅启动时读取，改动需重启
# LOG_KEEP_DAYS=7

# 启用 Android Companion App（替代 uiautomator dump）
# COMPANION_ENABLED=1