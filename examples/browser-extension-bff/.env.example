# BFF 环境变量。复制为 .env 后填入真实值，再用 pnpm dev / pnpm start 启动。
# 注意：脚本本身不读 .env，需要 `set -a; source .env; set +a` 或用 direnv 导出。

# 32 字节 base64url。用于加解密 SQLite 中的模型密钥，本身不入库。
# 生成：openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# 固定下来，否则换值后上次落库的密文解不开（key_version 不匹配）。
AGENT_KIT_MASTER_KEY=

# 扩展访问 BFF 的接入凭证。不是 LLM API Key，随便取一个字符串即可。
# 需与扩展设置里的「BFF 接入 token」一致。
BFF_API_TOKEN=dev-token

# 模型配置。只存在于 BFF 进程环境，扩展侧看不到。
LLM_API_KEY=
LLM_MODEL=

# OpenAI 兼容端点，默认火山方舟。
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
