{
  "name": "agent-kit",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:browser": "pnpm --filter browser-extension-bff dev",
    "dev:flutter": "pnpm --filter flutter-dev-bff dev",
    "start:browser": "pnpm --filter browser-extension-bff start",
    "start:flutter": "pnpm --filter flutter-dev-bff start",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260714.1",
    "@types/node": "24.3.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
